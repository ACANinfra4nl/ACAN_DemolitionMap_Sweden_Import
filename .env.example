# Warning: Do not add secrets (API keys and similar) to this file, as it source controlled!
# Use `.env.local` for any secrets, and ensure it is not added to source control
#
# Sanity project IDs (also in src/lib/countrySanity.ts):
#   LANGUAGE=nl  →  q9jkymv5
#   LANGUAGE=au  →  yps8kvw9
#   LANGUAGE=dk  →  obfbyt9x

NEXT_PUBLIC_SANITY_API_VERSION="2023-09-01"
NEXT_PUBLIC_SANITY_PROJECT_ID="q9jkymv5"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_MAPTILER_STYLE_URL=""
NEXT_PUBLIC_MIN_DEMOLITION_YEAR=2016
SANITY_AUTH_TOKEN="SECRET-SANITY-TOKEN"
SANITY_READ_TOKEN="SECRET-SANITY-READ-TOKEN"
# Optional per-country write tokens for the import page country selector.
# If omitted, SANITY_AUTH_TOKEN is used only for LANGUAGE's country.
# SANITY_AUTH_TOKEN_NL="SECRET-NL-WRITE-TOKEN"
# SANITY_AUTH_TOKEN_AU="SECRET-AU-WRITE-TOKEN"
# SANITY_AUTH_TOKEN_DK="SECRET-DK-WRITE-TOKEN"
# Draft preview URL (server). iframe uses NEXT_PUBLIC_* with the same secret value so Studio Preview works.
SANITY_PREVIEW_SECRET="SECRET-PREVIEW-TOKEN"
NEXT_PUBLIC_SANITY_PREVIEW_SECRET="SECRET-PREVIEW-TOKEN"
GEOAPIFY_TOKEN="SECRET-GEOAPIFY-TOKEN"
SANITY_REVALIDATE_SECRET="SECRET-REVALIDATION-TOKEN"
# Must match the Sanity webhook "Studio Update: Next.js revalidate" secret for this project.
# Webhook URL: https://<country-domain>/api/revalidate
IMPORT_ADMIN_SECRET="SECRET-IMPORT-ADMIN-TOKEN"
# nl | au | dk (or sv / en / … for other dictionaries)
LANGUAGE="nl"